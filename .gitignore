# Dependencies
node_modules/

# Build output
dist/
build/
release/
# ...trừ đúng một tệp: icon đóng gói. electron-builder đọc build/ theo mặc
# định và package.json trỏ thẳng vào đây. Mở cả thư mục thì thứ gì rơi vào
# build/ cũng theo dõi được, nên chỉ mở đúng tệp cần.
!build/
build/*
!build/icon.ico

# Tệp tạm và bản dự phòng mà database.js sinh ra khi lưu. Đây là dữ liệu thật.
*.sqlite
*.sqlite.bak
*.sqlite.tmp

# Database files
data/

# Trash (files to be deleted manually)
trash/

# Environment
.env
.vite
.DS_Store

# OS files
Thumbs.db
desktop.ini

# Kết quả kiểm thử (sinh lại được)
tests/reports/

# Sản phẩm dựng video demo (nặng, sinh lại được)
demo/build/
demo/out/

