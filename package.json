{
  "name": "money-flow",
  "version": "1.0.0",
  "description": "Money Flow — Quản lý tài chính cá nhân",
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently \"vite\" \"node server.js\" \"wait-on http://localhost:5173 http://localhost:3001 && env -u ELECTRON_RUN_AS_NODE electron .\"",
    "dev:web": "concurrently \"vite\" \"node server.js\"",
    "dev:server": "node server.js",
    "vite:dev": "vite",
    "electron:dev": "wait-on http://localhost:5173 && env -u ELECTRON_RUN_AS_NODE electron .",
    "build": "vite build && electron-builder",
    "start": "node server.js"
  },
  "browserslist": [
    "last 1 chrome version",
    "last 1 firefox version",
    "last 1 safari version"
  ],
  "dependencies": {
    "@phosphor-icons/react": "^2.1.7",
    "cors": "^2.8.5",
    "express": "^4.21.0",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^3.0.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.0",
    "recharts": "^2.12.7",
    "sql.js": "^1.10.3",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "concurrently": "^8.2.2",
    "electron": "^25.9.8",
    "electron-builder": "^24.13.3",
    "postcss": "^8.4.40",
    "puppeteer": "^25.1.0",
    "tailwindcss": "^3.4.7",
    "vite": "^5.4.0",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.financial.command-center",
    "productName": "Money Flow",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "data/**/*"
    ],
    "win": {
      "target": "nsis"
    }
  }
}
